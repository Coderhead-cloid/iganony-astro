---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Toolkit - Free Anonymous Instagram Utilities | IGAnony Pro">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="badge badge-purple text-xs mb-3">100% Free Public Utilities</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-4 font-display">
        Unlock the Toolkit's Power
      </h1>
      <p class="text-sm text-gray-400">
        Streamline your Instagram research with our anonymous viewers and intelligence utilities. No login or password required.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Story Viewer -->
      <a href="/stories" class="glass-panel p-6 flex flex-col justify-between group hover:-translate-y-1 transition duration-300">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#EC4899]/20 flex items-center justify-center text-[#EC4899] text-xl mb-6 group-hover:scale-110 transition">
            <i class="fa-solid fa-circle-play"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 font-display">Anonymous Story Viewer</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            Watch and download Instagram Stories and active Highlights completely discreetly without notifying the user.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-[#EC4899]">
          <span>Launch Story Viewer</span>
          <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Post & Reel Viewer -->
      <a href="/toolkit/post-viewer" class="glass-panel p-6 flex flex-col justify-between group hover:-translate-y-1 transition duration-300">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#00F0FF]/20 flex items-center justify-center text-[#00F0FF] text-xl mb-6 group-hover:scale-110 transition">
            <i class="fa-solid fa-image"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 font-display">Post & Reel HD Viewer</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            Inspect original high-resolution photos, carousels, and Reels without needing an active Instagram account.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-[#00F0FF]">
          <span>Inspect Media</span>
          <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Mutual Followers Checker -->
      <a href="/toolkit/mutual-checker" class="glass-panel p-6 flex flex-col justify-between group hover:-translate-y-1 transition duration-300">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#725CFF]/20 flex items-center justify-center text-[#725CFF] text-xl mb-6 group-hover:scale-110 transition">
            <i class="fa-solid fa-users-viewfinder"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 font-display">Mutual Followers Checker</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            Compare two Instagram profiles side-by-side to detect shared connections and determine if they follow each other.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-[#725CFF]">
          <span>Compare Mutuals</span>
          <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Unfollowers Tracker -->
      <a href="/toolkit/unfollowers" class="glass-panel p-6 flex flex-col justify-between group hover:-translate-y-1 transition duration-300">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#F59E0B]/20 flex items-center justify-center text-[#F59E0B] text-xl mb-6 group-hover:scale-110 transition">
            <i class="fa-solid fa-user-xmark"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 font-display">Unfollowers & Non-Followers</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            Find out who doesn't follow back and review who recently removed you or unfollowed your account.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-[#F59E0B]">
          <span>Check Unfollowers</span>
          <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Shadowban Checker -->
      <a href="/toolkit/shadowban" class="glass-panel p-6 flex flex-col justify-between group hover:-translate-y-1 transition duration-300">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#10B981]/20 flex items-center justify-center text-[#10B981] text-xl mb-6 group-hover:scale-110 transition">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 font-display">Shadowban & Hashtag Health</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            Audit hashtags, profile suppression status, and verify if your account is hidden from explore pages.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-[#10B981]">
          <span>Run Shadowban Audit</span>
          <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Follower Export Tool -->
      <div class="glass-panel p-6 flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#6366F1]/20 flex items-center justify-center text-[#6366F1] text-xl mb-6">
            <i class="fa-solid fa-file-csv"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 font-display">Follower CSV Export Tool</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            Export comprehensive lists of followers and followings with usernames and bios directly into CSV files.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-[#6366F1]">
          <a href="/api/export/cristiano" class="hover:underline flex items-center justify-between w-full">
            <span>Download Sample CSV</span>
            <i class="fa-solid fa-download"></i>
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>

