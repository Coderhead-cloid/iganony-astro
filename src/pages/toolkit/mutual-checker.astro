---
import Layout from '../../layouts/Layout.astro';
import { MutualIntelligenceService } from '../../services/mutualIntelligence';

const url = Astro.url;
let initialUserA = url.searchParams.get('user1') || url.searchParams.get('userA') || '';
let initialUserB = url.searchParams.get('user2') || url.searchParams.get('userB') || '';

let initialU1Following = url.searchParams.get('user1_following') || url.searchParams.get('list1') || '';
let initialU1Followers = url.searchParams.get('user1_followers') || '';
let initialU2Following = url.searchParams.get('user2_following') || url.searchParams.get('list2') || '';
let initialU2Followers = url.searchParams.get('user2_followers') || '';

let ssrMutuals: any = null;
let ssrError = '';
const hasSSRSubmit = Boolean(initialUserA && initialUserB);

if (hasSSRSubmit) {
  try {
    const mutualService = new MutualIntelligenceService();
    const hasLists = Boolean(initialU1Following || initialU1Followers || initialU2Following || initialU2Followers);
    ssrMutuals = await mutualService.findMutualConnections(
      initialUserA,
      initialUserB,
      true,
      hasLists ? {
        user1_following: initialU1Following,
        user1_followers: initialU1Followers,
        user2_following: initialU2Following,
        user2_followers: initialU2Followers,
      } : undefined
    );
  } catch (err: any) {
    ssrError = err.message || 'Error comparing profiles';
  }
}
---

<Layout title="Find Mutual Friends & Followers | IGAnony Pro">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#725CFF]/15 border border-[#725CFF]/30 text-purple-300 text-xs font-semibold mb-3 shadow-sm">
        <i class="fa-solid fa-users-viewfinder text-[#725CFF] animate-pulse"></i>
        <span>Automatic Mutual Friends & Network Telemetry</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-3 font-display tracking-tight">
        Find Mutual Friends on Instagram
      </h1>
      <p class="text-xs sm:text-sm text-gray-400 max-w-xl mx-auto leading-relaxed">
        Just enter two Instagram usernames. Our engine automatically cross-references their profiles, tagged collaborations, and networks to uncover their common mutual friends and relationship.
      </p>
    </div>

    <!-- 2-ID Search Card (Clean, Simple, Zero-Effort) -->
    <div class="glass-panel p-6 sm:p-8 max-w-3xl mx-auto mb-10 relative overflow-hidden border border-white/10 shadow-2xl rounded-2xl">
      <div class="absolute -right-20 -top-20 w-64 h-64 bg-[#725CFF]/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-[#00F0FF]/15 rounded-full blur-3xl pointer-events-none"></div>

      <form id="mutuals-form" onsubmit="handleMutualsSubmit(event)" class="relative z-10 space-y-5">
        
        <!-- Two Input Fields Side-by-Side with Center Swap Button -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 relative items-center">
          
          <!-- First Profile (Account A) -->
          <div class="bg-black/40 p-3.5 rounded-xl border border-white/10 focus-within:border-[#725CFF] transition">
            <label class="block text-[11px] font-bold text-purple-300 mb-1.5 uppercase tracking-wider flex items-center justify-between">
              <span>First Account</span>
              <span class="text-[10px] text-gray-500 font-normal">Profile A</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-[#725CFF] font-bold text-sm">@</span>
              <input type="text" id="user1-input" name="user1" value={initialUserA} required
                     placeholder="e.g. gaurav_rathi83"
                     class="w-full bg-[#0B0D17] border border-white/10 rounded-lg pl-8 pr-3 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-[#725CFF] transition">
            </div>
          </div>

          <!-- Swap Button (Desktop Center Float) -->
          <button type="button" onclick="swapUserInputs()" title="Swap accounts" 
                  class="hidden sm:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[#131627] border border-white/20 hover:border-[#725CFF] text-gray-300 hover:text-white items-center justify-center text-xs shadow-xl hover:scale-110 active:scale-95 transition duration-200 z-20">
            <i class="fa-solid fa-arrow-right-arrow-left"></i>
          </button>

          <!-- Swap Button (Mobile) -->
          <div class="sm:hidden flex justify-center -my-2 relative z-20">
            <button type="button" onclick="swapUserInputs()" title="Swap accounts" 
                    class="w-8 h-8 rounded-full bg-[#131627] border border-white/20 text-gray-300 flex items-center justify-center text-xs shadow-lg active:scale-95 transition">
              <i class="fa-solid fa-arrow-up-down"></i>
            </button>
          </div>

          <!-- Second Profile (Account B) -->
          <div class="bg-black/40 p-3.5 rounded-xl border border-white/10 focus-within:border-[#00F0FF] transition">
            <label class="block text-[11px] font-bold text-cyan-300 mb-1.5 uppercase tracking-wider flex items-center justify-between">
              <span>Second Account</span>
              <span class="text-[10px] text-gray-500 font-normal">Profile B</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-[#00F0FF] font-bold text-sm">@</span>
              <input type="text" id="user2-input" name="user2" value={initialUserB} required
                     placeholder="e.g. __naman.sharma__0.1"
                     class="w-full bg-[#0B0D17] border border-white/10 rounded-lg pl-8 pr-3 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-[#00F0FF] transition">
            </div>
          </div>

        </div>

        <!-- Big Primary Action Button -->
        <button type="submit" id="btn-find-mutuals"
                class="w-full btn-primary py-3.5 text-sm font-bold flex items-center justify-center gap-2.5 shadow-xl shadow-[#725CFF]/25 hover:shadow-[#725CFF]/45 transition transform active:scale-[0.99]">
          <i class="fa-solid fa-satellite-dish text-base"></i>
          <span id="btn-find-label">Find Mutual Friends Now</span>
        </button>

        <!-- Optional Collapsed Manual Lists Section (For Power Users) -->
        <div class="pt-2 border-t border-white/5">
          <button type="button" onclick="toggleAdvancedLists()" id="btn-toggle-advanced"
                  class="text-[11px] text-gray-400 hover:text-purple-300 transition flex items-center gap-1.5 mx-auto">
            <i class="fa-solid fa-sliders text-[#725CFF]"></i>
            <span id="label-toggle-advanced">Optional: Paste follower/following lists directly &darr;</span>
          </button>

          <div id="advanced-lists-panel" class="hidden mt-3 p-4 rounded-xl bg-black/40 border border-white/5 space-y-3">
            <p class="text-[11px] text-gray-400">
              Have exported follower lists? Paste them below to cross-reference with 100% precision:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[10px] font-bold text-purple-300 mb-1">Account A Follow List:</label>
                <textarea id="adv-list-a" rows="3" placeholder="Paste Account A's following or followers..."
                          class="w-full bg-[#0B0D17] border border-white/10 rounded-lg p-2 text-white font-mono text-[11px] focus:outline-none focus:border-[#725CFF]">{initialU1Following}</textarea>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-cyan-300 mb-1">Account B Follow List:</label>
                <textarea id="adv-list-b" rows="3" placeholder="Paste Account B's following or followers..."
                          class="w-full bg-[#0B0D17] border border-white/10 rounded-lg p-2 text-white font-mono text-[11px] focus:outline-none focus:border-[#00F0FF]">{initialU2Following}</textarea>
              </div>
            </div>
          </div>
        </div>

      </form>

      <!-- Quick Test Pair Suggestions -->
      <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-center gap-2 flex-wrap text-xs text-gray-400">
        <span class="text-gray-500 text-[11px]">Quick Pairs:</span>
        <button type="button" onclick="setPair('gaurav_rathi83', '__naman.sharma__0.1')" class="px-2.5 py-1 rounded-lg bg-white/[0.03] hover:bg-white/[0.08] text-gray-300 hover:text-white border border-white/5 transition text-[11px]">
          @gaurav_rathi83 & @__naman.sharma__0.1
        </button>
        <button type="button" onclick="setPair('cristiano', 'leomessi')" class="px-2.5 py-1 rounded-lg bg-white/[0.03] hover:bg-white/[0.08] text-gray-300 hover:text-white border border-white/5 transition text-[11px]">
          @cristiano & @leomessi
        </button>
        <button type="button" onclick="setPair('virat.kohli', 'rohit_sharma')" class="px-2.5 py-1 rounded-lg bg-white/[0.03] hover:bg-white/[0.08] text-gray-300 hover:text-white border border-white/5 transition text-[11px]">
          @virat.kohli & @rohit_sharma
        </button>
        <button type="button" onclick="setPair('github', 'vercel')" class="px-2.5 py-1 rounded-lg bg-white/[0.03] hover:bg-white/[0.08] text-gray-300 hover:text-white border border-white/5 transition text-[11px]">
          @github & @vercel
        </button>
      </div>
    </div>

    <!-- Scanning State Animation (Shown during search) -->
    <div id="scanning-state" class="hidden max-w-xl mx-auto my-8 p-8 glass-panel text-center border border-[#725CFF]/30 rounded-2xl shadow-2xl relative overflow-hidden">
      <div class="w-16 h-16 rounded-full bg-[#725CFF]/15 border border-[#725CFF]/40 flex items-center justify-center text-2xl text-[#725CFF] mx-auto mb-4 animate-spin">
        <i class="fa-solid fa-compass"></i>
      </div>
      <h3 class="text-lg font-bold text-white mb-2 font-display">Cross-Referencing Profiles...</h3>
      <p id="scanning-step-text" class="text-xs text-gray-400 animate-pulse">
        Retrieving Instagram profiles and analyzing shared connections...
      </p>
      <div class="w-48 h-1 bg-white/10 rounded-full mx-auto mt-4 overflow-hidden">
        <div class="w-full h-full bg-gradient-to-r from-[#725CFF] to-[#00F0FF] animate-pulse"></div>
      </div>
    </div>

    <!-- Error State Box -->
    <div id="mutual-error-box" class="hidden max-w-3xl mx-auto mb-8 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-center gap-3">
      <i class="fa-solid fa-circle-exclamation text-base shrink-0 text-rose-400"></i>
      <span id="mutual-error-msg"></span>
    </div>

    <!-- Toast Notification (Copied to Clipboard) -->
    <div id="copy-toast" class="fixed bottom-6 right-6 z-50 bg-[#131627] border border-[#725CFF] text-white px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2 text-xs font-semibold transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300">
      <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
      <span id="copy-toast-msg">Copied to clipboard!</span>
    </div>

    <!-- Results Dashboard (Displayed once mutuals are found) -->
    <div id="results-dashboard" class={ssrMutuals ? 'block' : 'hidden'}>
      
      <!-- Comparison Overview Card -->
      <div class="glass-panel p-6 sm:p-8 relative overflow-hidden mb-8 border border-white/10 rounded-2xl shadow-xl">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#00F0FF]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-7 gap-6 items-center relative z-10">
          
          <!-- Account A Summary -->
          <div class="lg:col-span-3 flex items-center gap-4 bg-black/40 p-4 rounded-2xl border border-white/5">
            <img id="res-avatar-a" src={ssrMutuals?.profile1?.avatar_url || `https://api.dicebear.com/7.x/avataaars/svg?seed=userA`} 
                 alt="avatar A" referrerpolicy="no-referrer"
                 onerror="this.onerror=null; this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent(this.alt || 'userA');"
                 class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border-2 border-[#725CFF]/40 shadow-lg shrink-0 bg-white/5" />
            <div class="min-w-0 flex-grow">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h3 id="res-user-a" class="font-extrabold text-white text-base sm:text-lg font-display truncate">
                  @{ssrMutuals?.profile1?.username || initialUserA || 'Account A'}
                </h3>
              </div>
              <p id="res-name-a" class="text-xs text-gray-300 truncate">{ssrMutuals?.profile1?.full_name || 'Profile A'}</p>
              <div class="flex items-center gap-3 mt-2 text-[11px] text-gray-400">
                <span id="res-following-a-count"><strong class="text-white">{(ssrMutuals?.profile1?.following_count ?? 0).toLocaleString()}</strong> following</span>
                <span>•</span>
                <span id="res-followers-a-count"><strong class="text-white">{(ssrMutuals?.profile1?.followers_count ?? 0).toLocaleString()}</strong> followers</span>
              </div>
            </div>
          </div>

          <!-- Central Connection Gauge -->
          <div class="lg:col-span-1 flex flex-col items-center justify-center text-center py-2">
            <div id="gauge-circle" class="w-14 h-14 rounded-full flex items-center justify-center text-xl font-bold border shadow-xl mb-2 bg-[#725CFF]/15 border-[#725CFF]/40 text-[#725CFF] transition-all duration-500">
              <i class="fa-solid fa-link"></i>
            </div>
            <span id="res-affinity-score" class="text-sm font-black tracking-tight text-[#725CFF]">
              {ssrMutuals?.metrics?.affinity_score || 0}%
            </span>
            <span class="text-[9px] uppercase tracking-wider text-gray-400 font-bold block mt-0.5">
              Shared Overlap
            </span>
          </div>

          <!-- Account B Summary -->
          <div class="lg:col-span-3 flex items-center gap-4 bg-black/40 p-4 rounded-2xl border border-white/5">
            <img id="res-avatar-b" src={ssrMutuals?.profile2?.avatar_url || `https://api.dicebear.com/7.x/avataaars/svg?seed=userB`} 
                 alt="avatar B" referrerpolicy="no-referrer"
                 onerror="this.onerror=null; this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent(this.alt || 'userB');"
                 class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border-2 border-[#00F0FF]/40 shadow-lg shrink-0 bg-white/5" />
            <div class="min-w-0 flex-grow">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h3 id="res-user-b" class="font-extrabold text-white text-base sm:text-lg font-display truncate">
                  @{ssrMutuals?.profile2?.username || initialUserB || 'Account B'}
                </h3>
              </div>
              <p id="res-name-b" class="text-xs text-gray-300 truncate">{ssrMutuals?.profile2?.full_name || 'Profile B'}</p>
              <div class="flex items-center gap-3 mt-2 text-[11px] text-gray-400">
                <span id="res-following-b-count"><strong class="text-white">{(ssrMutuals?.profile2?.following_count ?? 0).toLocaleString()}</strong> following</span>
                <span>•</span>
                <span id="res-followers-b-count"><strong class="text-white">{(ssrMutuals?.profile2?.followers_count ?? 0).toLocaleString()}</strong> followers</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Reciprocity Status Banner -->
        <div class="mt-6 pt-5 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3 text-xs">
            <div id="rel-status-icon-wrap" class="w-9 h-9 rounded-xl bg-white/5 flex items-center justify-center text-gray-300 shrink-0">
              <i id="rel-status-icon" class="fa-solid fa-handshake text-sm"></i>
            </div>
            <div>
              <span class="font-bold text-white block">
                Direct Relationship: <span id="rel-status-label" class="text-[#00F0FF]">Comparing Profiles...</span>
              </span>
              <div class="flex items-center gap-4 text-[11px] text-gray-400 mt-0.5">
                <span id="rel-a-to-b" class="flex items-center gap-1.5">
                  <i class="fa-solid fa-circle-xmark text-gray-500"></i> Account A follows Account B
                </span>
                <span id="rel-b-to-a" class="flex items-center gap-1.5">
                  <i class="fa-solid fa-circle-xmark text-gray-500"></i> Account B follows Account A
                </span>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <button type="button" onclick="copyAllMutualUsernames()" class="btn-secondary py-2 px-3 text-xs font-semibold flex items-center gap-1.5 text-purple-300 hover:text-white border border-[#725CFF]/30 hover:border-[#725CFF]" title="Copy all common mutual usernames">
              <i class="fa-solid fa-copy text-[#725CFF]"></i>
              <span>Copy All IDs</span>
            </button>
            <button type="button" onclick="exportMutualsCSV()" class="btn-secondary py-2 px-3 text-xs font-semibold flex items-center gap-1.5" title="Export as CSV">
              <i class="fa-solid fa-download"></i>
              <span>Export CSV</span>
            </button>
          </div>
        </div>

      </div>

      <!-- 4 Metric Cards with Fluid Counter Animations -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        
        <div class="glass-panel p-4 flex items-center gap-3 border border-white/5 hover:border-[#725CFF]/40 transition rounded-xl">
          <div class="w-11 h-11 rounded-xl bg-[#725CFF]/15 text-[#725CFF] flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-user-plus"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase text-gray-400 block font-bold tracking-wider">Both Follow</span>
            <span id="metric-mutual-following" class="text-xl font-extrabold text-white counter-num">0</span>
          </div>
        </div>

        <div class="glass-panel p-4 flex items-center gap-3 border border-white/5 hover:border-[#00F0FF]/40 transition rounded-xl">
          <div class="w-11 h-11 rounded-xl bg-[#00F0FF]/15 text-[#00F0FF] flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-users"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase text-gray-400 block font-bold tracking-wider">Follow Both</span>
            <span id="metric-mutual-followers" class="text-xl font-extrabold text-[#00F0FF] counter-num">0</span>
          </div>
        </div>

        <div class="glass-panel p-4 flex items-center gap-3 border border-white/5 hover:border-[#10B981]/40 transition rounded-xl">
          <div class="w-11 h-11 rounded-xl bg-[#10B981]/15 text-[#10B981] flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-network-wired"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase text-gray-400 block font-bold tracking-wider">Mutual Friends</span>
            <span id="metric-total-mutuals" class="text-xl font-extrabold text-[#10B981] counter-num">0</span>
          </div>
        </div>

        <div class="glass-panel p-4 flex items-center gap-3 border border-white/5 hover:border-[#F59E0B]/40 transition rounded-xl">
          <div class="w-11 h-11 rounded-xl bg-[#F59E0B]/15 text-[#F59E0B] flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-arrows-split-up-and-left"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase text-gray-400 block font-bold tracking-wider">Cross Overlaps</span>
            <span id="metric-cross-matches" class="text-xl font-extrabold text-[#F59E0B] counter-num">0</span>
          </div>
        </div>

      </div>

      <!-- Filter Tabs & Search Bar -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-b border-white/10 pb-4 mb-6">
        
        <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0">
          <button type="button" onclick="filterResultsTab('all')" id="tab-res-all" 
                  class="mutual-tab-pill px-4 py-2 rounded-xl text-xs font-bold bg-[#725CFF] text-white flex items-center gap-2 transition shrink-0 shadow-md">
            <i class="fa-solid fa-grip"></i>
            <span>All Mutuals (<span id="tab-cnt-all">0</span>)</span>
          </button>
          
          <button type="button" onclick="filterResultsTab('following')" id="tab-res-following" 
                  class="mutual-tab-pill px-4 py-2 rounded-xl text-xs font-bold text-gray-400 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] flex items-center gap-2 transition shrink-0">
            <i class="fa-solid fa-user-plus text-[#725CFF]"></i>
            <span>Both Follow (<span id="tab-cnt-following">0</span>)</span>
          </button>
          
          <button type="button" onclick="filterResultsTab('followers')" id="tab-res-followers" 
                  class="mutual-tab-pill px-4 py-2 rounded-xl text-xs font-bold text-gray-400 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] flex items-center gap-2 transition shrink-0">
            <i class="fa-solid fa-users text-[#00F0FF]"></i>
            <span>Follow Both (<span id="tab-cnt-followers">0</span>)</span>
          </button>
        </div>

        <!-- Live Instant Search Bar -->
        <div class="relative w-full sm:w-72">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-500 text-xs">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input type="text" id="live-search-input" onkeyup="filterCardsByQuery()" placeholder="Filter mutual accounts by handle..."
                 class="w-full bg-[#0B0D17] border border-white/10 rounded-xl pl-9 pr-3 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-[#725CFF] transition">
        </div>

      </div>

      <!-- Zero Mutuals State (Honest, clean empty-state) -->
      <div id="zero-mutuals-view" class="hidden glass-panel p-10 text-center max-w-2xl mx-auto my-6 border border-white/10 rounded-2xl relative overflow-hidden">
        <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-2xl text-gray-400 mx-auto mb-4">
          <i class="fa-solid fa-users-slash"></i>
        </div>
        <h3 class="text-xl font-bold text-white mb-2 font-display">No Mutual Friends Detected</h3>
        <p id="zero-state-details" class="text-xs sm:text-sm text-gray-400 max-w-md mx-auto mb-5 leading-relaxed">
          The two accounts do not share any public mutual friends, shared following, or tagged collaborations.
        </p>
      </div>

      <!-- Mutual Profile Cards Grid -->
      <div id="mutual-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <!-- Rendered dynamically -->
      </div>

    </div>

  </div>

  <style>
    @keyframes cardFadeInUp {
      0% {
        opacity: 0;
        transform: translateY(12px) scale(0.97);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .mutual-item-card {
      animation: cardFadeInUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: var(--stagger-delay, 0ms);
    }
  </style>

  <script is:inline>
    window.mutualState = {
      userA: '',
      userB: '',
      allMutuals: [],
      mutualFollowing: [],
      mutualFollowers: [],
      crossConnections: [],
      currentTab: 'all',
    };

    window.toggleAdvancedLists = function() {
      const panel = document.getElementById('advanced-lists-panel');
      const label = document.getElementById('label-toggle-advanced');
      if (panel) {
        if (panel.classList.contains('hidden')) {
          panel.classList.remove('hidden');
          if (label) label.innerText = 'Hide manual list importer &uarr;';
        } else {
          panel.classList.add('hidden');
          if (label) label.innerText = 'Optional: Paste follower/following lists directly &darr;';
        }
      }
    };

    window.swapUserInputs = function() {
      const u1 = document.getElementById('user1-input');
      const u2 = document.getElementById('user2-input');
      if (u1 && u2) {
        const temp = u1.value;
        u1.value = u2.value;
        u2.value = temp;
      }
    };

    window.setPair = function(a, b) {
      const u1 = document.getElementById('user1-input');
      const u2 = document.getElementById('user2-input');
      if (u1) u1.value = a;
      if (u2) u2.value = b;
      handleMutualsSubmit();
    };

    function animateNumber(elemId, start, end, duration = 800) {
      const obj = document.getElementById(elemId);
      if (!obj) return;
      if (start === end) {
        obj.innerText = end.toLocaleString();
        return;
      }
      const range = end - start;
      const minTimer = 30;
      let stepTime = Math.abs(Math.floor(duration / range));
      stepTime = Math.max(stepTime, minTimer);
      const startTime = new Date().getTime();
      const endTime = startTime + duration;

      function run() {
        const now = new Date().getTime();
        const remaining = Math.max((endTime - now) / duration, 0);
        const value = Math.round(end - (remaining * range));
        obj.innerText = value.toLocaleString();
        if (value !== end) {
          requestAnimationFrame(run);
        }
      }
      requestAnimationFrame(run);
    }

    // Handles the primary submit: just 2 IDs
    window.handleMutualsSubmit = async function(e, force = false) {
      if (e) e.preventDefault();

      const userA = document.getElementById('user1-input')?.value.trim().toLowerCase().replace(/^@/, '') || '';
      const userB = document.getElementById('user2-input')?.value.trim().toLowerCase().replace(/^@/, '') || '';

      const errBox = document.getElementById('mutual-error-box');
      const errMsg = document.getElementById('mutual-error-msg');
      if (errBox) errBox.classList.add('hidden');

      if (!userA || !userB) {
        if (errBox && errMsg) {
          errMsg.innerText = 'Please enter both Account A and Account B usernames.';
          errBox.classList.remove('hidden');
        }
        return;
      }

      if (userA === userB) {
        if (errBox && errMsg) {
          errMsg.innerText = 'Please enter two different usernames to compare mutual connections.';
          errBox.classList.remove('hidden');
        }
        return;
      }

      // Check if user expanded manual lists
      const listA = document.getElementById('adv-list-a')?.value.trim() || '';
      const listB = document.getElementById('adv-list-b')?.value.trim() || '';

      // Show scanning state
      const scanBox = document.getElementById('scanning-state');
      const scanText = document.getElementById('scanning-step-text');
      const btn = document.getElementById('btn-find-mutuals');
      const btnLbl = document.getElementById('btn-find-label');

      if (scanBox) scanBox.classList.remove('hidden');
      if (btn) btn.disabled = true;
      if (btnLbl) btnLbl.innerText = 'Analyzing Networks...';

      if (scanText) scanText.innerText = `Connecting to Instagram telemetry for @${userA} and @${userB}...`;

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 25000);

        const resp = await fetch('/api/toolkit/mutuals', {
          method: 'POST',
          signal: controller.signal,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user1: userA,
            user2: userB,
            user1_following: listA,
            user2_following: listB,
            refresh: Boolean(force),
          })
        });
        clearTimeout(timeoutId);

        const data = await resp.json();

        if (scanBox) scanBox.classList.add('hidden');
        if (btn) btn.disabled = false;
        if (btnLbl) btnLbl.innerText = 'Find Mutual Friends Now';

        if (!data.success) {
          if (errBox && errMsg) {
            errMsg.innerText = data.error || 'Failed to compare profiles.';
            errBox.classList.remove('hidden');
          }
          return;
        }

        renderMutualResults(data);

      } catch (err) {
        if (scanBox) scanBox.classList.add('hidden');
        if (btn) btn.disabled = false;
        if (btnLbl) btnLbl.innerText = 'Find Mutual Friends Now';
        if (errBox && errMsg) {
          errMsg.innerText = err.name === 'AbortError' 
            ? 'Request timed out while analyzing profiles. Please click Find Mutual Friends again.' 
            : 'Network error: ' + err.message;
          errBox.classList.remove('hidden');
        }
      }
    };

    function renderMutualResults(data) {
      const dashboard = document.getElementById('results-dashboard');
      if (dashboard) {
        dashboard.classList.remove('hidden');
        dashboard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      const p1 = data.profile1 || {};
      const p2 = data.profile2 || {};
      const rel = data.relationship || {};
      const metrics = data.metrics || {};
      const allMutuals = data.all_mutuals || [];
      const mutualFing = data.mutual_following || [];
      const mutualFers = data.mutual_followers || [];
      const cross = data.cross_connections || [];

      window.mutualState.userA = p1.username;
      window.mutualState.userB = p2.username;
      window.mutualState.allMutuals = allMutuals;
      window.mutualState.mutualFollowing = mutualFing;
      window.mutualState.mutualFollowers = mutualFers;
      window.mutualState.crossConnections = cross;

      if (p1.username && p2.username) {
        try {
          window.history.replaceState({}, '', `/toolkit/mutual-checker?user1=${encodeURIComponent(p1.username)}&user2=${encodeURIComponent(p2.username)}`);
        } catch (e) {}
      }

      // Update Profile A
      const elUserA = document.getElementById('res-user-a');
      const elNameA = document.getElementById('res-name-a');
      const elAvatarA = document.getElementById('res-avatar-a');
      const elFingA = document.getElementById('res-following-a-count');
      const elFersA = document.getElementById('res-followers-a-count');

      if (elUserA) elUserA.innerText = `@${p1.username}`;
      if (elNameA) elNameA.innerText = p1.full_name || p1.username;
      if (elAvatarA && p1.avatar_url) elAvatarA.src = p1.avatar_url;
      if (elFingA) elFingA.innerHTML = `<strong class="text-white">${(p1.following_count || 0).toLocaleString()}</strong> following`;
      if (elFersA) elFersA.innerHTML = `<strong class="text-white">${(p1.followers_count || 0).toLocaleString()}</strong> followers`;

      // Update Profile B
      const elUserB = document.getElementById('res-user-b');
      const elNameB = document.getElementById('res-name-b');
      const elAvatarB = document.getElementById('res-avatar-b');
      const elFingB = document.getElementById('res-following-b-count');
      const elFersB = document.getElementById('res-followers-b-count');

      if (elUserB) elUserB.innerText = `@${p2.username}`;
      if (elNameB) elNameB.innerText = p2.full_name || p2.username;
      if (elAvatarB && p2.avatar_url) elAvatarB.src = p2.avatar_url;
      if (elFingB) elFingB.innerHTML = `<strong class="text-white">${(p2.following_count || 0).toLocaleString()}</strong> following`;
      if (elFersB) elFersB.innerHTML = `<strong class="text-white">${(p2.followers_count || 0).toLocaleString()}</strong> followers`;

      // Affinity score
      const affScore = document.getElementById('res-affinity-score');
      if (affScore) affScore.innerText = `${metrics.affinity_score || 0}%`;

      // Relationship banner
      const relLbl = document.getElementById('rel-status-label');
      const relAtoB = document.getElementById('rel-a-to-b');
      const relBtoA = document.getElementById('rel-b-to-a');
      const relIcon = document.getElementById('rel-status-icon');
      const relWrap = document.getElementById('rel-status-icon-wrap');

      if (rel.is_mutual_follow) {
        if (relLbl) {
          relLbl.innerText = 'Mutual Follow (Both Follow Each Other)';
          relLbl.className = 'text-[#10B981] font-extrabold';
        }
        if (relIcon) relIcon.className = 'fa-solid fa-handshake text-[#10B981] text-base';
        if (relWrap) relWrap.className = 'w-9 h-9 rounded-xl bg-emerald-500/20 flex items-center justify-center text-[#10B981] shrink-0 border border-emerald-500/30';
      } else if (rel.user1_follows_user2) {
        if (relLbl) {
          relLbl.innerText = `@${p1.username} follows @${p2.username}`;
          relLbl.className = 'text-[#725CFF] font-bold';
        }
        if (relIcon) relIcon.className = 'fa-solid fa-arrow-right text-[#725CFF]';
      } else if (rel.user2_follows_user1) {
        if (relLbl) {
          relLbl.innerText = `@${p2.username} follows @${p1.username}`;
          relLbl.className = 'text-[#00F0FF] font-bold';
        }
        if (relIcon) relIcon.className = 'fa-solid fa-arrow-left text-[#00F0FF]';
      } else {
        if (relLbl) {
          relLbl.innerText = allMutuals.length > 0 ? `Connected via ${allMutuals.length} Mutual Connection${allMutuals.length > 1 ? 's' : ''}` : 'No Direct Follow Found';
          relLbl.className = 'text-gray-400 font-medium';
        }
        if (relIcon) relIcon.className = 'fa-solid fa-users text-gray-400';
      }

      if (relAtoB) {
        relAtoB.innerHTML = `<i class="fa-solid ${rel.user1_follows_user2 ? 'fa-circle-check text-[#10B981]' : 'fa-circle-xmark text-gray-500'}"></i> @${p1.username} follows @${p2.username}`;
      }
      if (relBtoA) {
        relBtoA.innerHTML = `<i class="fa-solid ${rel.user2_follows_user1 ? 'fa-circle-check text-[#10B981]' : 'fa-circle-xmark text-gray-500'}"></i> @${p2.username} follows @${p1.username}`;
      }

      // Animate 4 metrics
      animateNumber('metric-mutual-following', 0, metrics.mutual_following_count || mutualFing.length);
      animateNumber('metric-mutual-followers', 0, metrics.mutual_followers_count || mutualFers.length);
      animateNumber('metric-total-mutuals', 0, allMutuals.length);
      animateNumber('metric-cross-matches', 0, cross.length);

      // Tab badges
      const tcAll = document.getElementById('tab-cnt-all');
      const tcFing = document.getElementById('tab-cnt-following');
      const tcFers = document.getElementById('tab-cnt-followers');
      if (tcAll) tcAll.innerText = allMutuals.length;
      if (tcFing) tcFing.innerText = mutualFing.length;
      if (tcFers) tcFers.innerText = mutualFers.length;

      // Populate cards
      renderCards(allMutuals);
    }

    function renderCards(items) {
      const grid = document.getElementById('mutual-cards-grid');
      const zeroView = document.getElementById('zero-mutuals-view');
      const zeroDetails = document.getElementById('zero-state-details');

      if (!grid) return;
      grid.innerHTML = '';

      if (!items || items.length === 0) {
        if (zeroView) zeroView.classList.remove('hidden');
        if (zeroDetails) {
          const uA = window.mutualState.userA || 'Account A';
          const uB = window.mutualState.userB || 'Account B';
          zeroDetails.innerText = `No common mutual connections detected between @${uA} and @${uB}. These accounts operate in separate social circles.`;
        }
        return;
      }

      if (zeroView) zeroView.classList.add('hidden');

      items.forEach((m, idx) => {
        const card = document.createElement('div');
        card.className = 'mutual-item-card glass-panel p-4 flex flex-col justify-between group hover:border-[#725CFF]/60 hover:shadow-lg hover:shadow-[#725CFF]/10 transition duration-300 rounded-xl relative';
        card.style.setProperty('--stagger-delay', `${Math.min(idx * 35, 400)}ms`);
        card.setAttribute('data-username', m.username.toLowerCase());
        card.setAttribute('data-name', (m.full_name || '').toLowerCase());

        let badgeBg = 'bg-[#725CFF]/20 text-[#C4B5FD] border-[#725CFF]/30';
        let badgeIcon = 'fa-link';
        if (m.connection_type === 'mutual_following') {
          badgeBg = 'bg-[#00F0FF]/15 text-[#00F0FF] border-[#00F0FF]/30';
          badgeIcon = 'fa-user-plus';
        } else if (m.connection_type === 'mutual_follower') {
          badgeBg = 'bg-[#10B981]/15 text-[#10B981] border-[#10B981]/30';
          badgeIcon = 'fa-users';
        } else if (m.connection_type === 'cross_connection') {
          badgeBg = 'bg-[#F59E0B]/15 text-[#F59E0B] border-[#F59E0B]/30';
          badgeIcon = 'fa-arrows-split-up-and-left';
        }

        card.innerHTML = `
          <div>
            <div class="flex items-start gap-3 mb-3">
              <img src="${m.avatar_url}" alt="${m.username}" loading="lazy" referrerpolicy="no-referrer"
                   onerror="this.onerror=null; this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent('${m.username}');"
                   class="w-12 h-12 rounded-xl object-cover border border-white/10 group-hover:scale-105 transition duration-200 shrink-0 bg-white/5" />
              <div class="min-w-0 flex-grow">
                <div class="flex items-center gap-1.5 truncate">
                  <span class="text-xs font-bold text-white truncate">@${m.username}</span>
                  ${m.is_verified ? '<i class="fa-solid fa-circle-check text-[#00F0FF] text-[10px]" title="Verified"></i>' : ''}
                </div>
                <p class="text-[11px] text-gray-400 truncate mt-0.5">${m.full_name || m.username}</p>
                <span class="mt-2 inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-bold border ${badgeBg}">
                  <i class="fa-solid ${badgeIcon}"></i>
                  ${m.label || 'Mutual Friend'}
                </span>
              </div>
            </div>
          </div>
          <div class="pt-3 border-t border-white/5 flex items-center justify-between text-[11px]">
            <a href="/report/${m.username}" class="text-[#725CFF] hover:text-[#00F0FF] font-semibold flex items-center gap-1 transition">
              <span>Inspect Profile</span>
              <i class="fa-solid fa-arrow-right text-[9px]"></i>
            </a>
            <a href="https://www.instagram.com/${m.username}/" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-white transition" title="Open on Instagram">
              <i class="fa-brands fa-instagram text-xs"></i>
            </a>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    window.filterResultsTab = function(tab) {
      window.mutualState.currentTab = tab;
      const tabs = ['all', 'following', 'followers'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-res-${t}`);
        if (btn) {
          if (t === tab) {
            btn.className = 'mutual-tab-pill px-4 py-2 rounded-xl text-xs font-bold bg-[#725CFF] text-white flex items-center gap-2 transition shrink-0 shadow-md';
          } else {
            btn.className = 'mutual-tab-pill px-4 py-2 rounded-xl text-xs font-bold text-gray-400 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] flex items-center gap-2 transition shrink-0';
          }
        }
      });

      let items = window.mutualState.allMutuals;
      if (tab === 'following') items = window.mutualState.mutualFollowing;
      else if (tab === 'followers') items = window.mutualState.mutualFollowers;

      renderCards(items);
      filterCardsByQuery();
    };

    window.filterCardsByQuery = function() {
      const q = document.getElementById('live-search-input')?.value.toLowerCase().trim() || '';
      const cards = document.querySelectorAll('.mutual-item-card');
      cards.forEach(card => {
        const u = card.getAttribute('data-username') || '';
        const n = card.getAttribute('data-name') || '';
        if (!q || u.includes(q) || n.includes(q)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    };

    function showToast(msg) {
      const toast = document.getElementById('copy-toast');
      const toastMsg = document.getElementById('copy-toast-msg');
      if (toast && toastMsg) {
        toastMsg.innerText = msg;
        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');
        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }, 2500);
      }
    }

    window.copyAllMutualUsernames = function() {
      const items = window.mutualState.allMutuals || [];
      if (items.length === 0) {
        showToast('No mutual usernames to copy');
        return;
      }
      const text = items.map(i => `@${i.username}`).join(', ');
      navigator.clipboard.writeText(text).then(() => {
        showToast(`✓ Copied ${items.length} mutual usernames to clipboard!`);
      }).catch(() => {
        showToast(`Copied ${items.length} IDs!`);
      });
    };

    window.exportMutualsCSV = function() {
      const items = window.mutualState.allMutuals || [];
      if (items.length === 0) {
        showToast('No mutual connections to export');
        return;
      }
      const uA = window.mutualState.userA || 'Account_A';
      const uB = window.mutualState.userB || 'Account_B';
      let csv = 'Username,Full Name,Connection Type,Label,Instagram Link\n';
      items.forEach(i => {
        csv += `"${i.username}","${(i.full_name || '').replace(/"/g, '""')}","${i.connection_type || ''}","${i.label || ''}","https://www.instagram.com/${i.username}/"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `mutuals_${uA}_${uB}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast(`✓ Exported mutuals_${uA}_${uB}.csv`);
    };

    // Auto-trigger if query params exist on page load and SSR did not already render results
    document.addEventListener('DOMContentLoaded', () => {
      const dashboard = document.getElementById('results-dashboard');
      const isAlreadyRendered = dashboard && !dashboard.classList.contains('hidden');
      if (isAlreadyRendered) return;

      const u1 = document.getElementById('user1-input')?.value.trim();
      const u2 = document.getElementById('user2-input')?.value.trim();
      if (u1 && u2) {
        handleMutualsSubmit(null, false);
      }
    });
  </script>
</Layout>
